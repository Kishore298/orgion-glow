# Server
PORT=5000
NODE_ENV=development
CLIENT_CUSTOMER_URL=http://localhost:5173
CLIENT_ADMIN_URL=http://localhost:5174

# Database (MongoDB Atlas or local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/orgion

# JWT Secrets (Access token in httpOnly cookie + Refresh token rotation)
JWT_ACCESS_SECRET=replace_with_strong_random_access_secret
JWT_REFRESH_SECRET=replace_with_strong_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Razorpay (INR)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Image Uploads (cloudinary | local)
UPLOAD_STORAGE=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP Email (Nodemailer - leave empty in dev to stub to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ORGION <orgion.we@gmail.com>"

# Firebase Cloud Messaging (Admin SDK - optional in dev)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Static Site Config Overrides (optional)
ORGION_WHATSAPP_NUMBER=919360910640
ORGION_SUPPORT_EMAIL=orgion.we@gmail.com
ORGION_SUPPORT_PHONE="+91 93609 10640"
ORGION_GSTIN=29ABCDE1234F1Z5
SHIPPING_STUB_CHARGE=0
FREE_SHIPPING_THRESHOLD=
